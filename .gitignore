# ============================================================
# FinSight AI - Git Ignore
# ============================================================

# ------------------------------------------------------------
# Node.js / React
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
out/

# Environment variables / secrets
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Java / Spring Boot / Maven
# ------------------------------------------------------------

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven
target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------
# IDEs
# ------------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------
# Spring Boot configuration containing secrets
# ------------------------------------------------------------

# Ignore real application configuration
application.properties
application.yml
application.yaml

# Allow safe example configuration
!application-example.properties

# ------------------------------------------------------------
# Uploads / User Files
# ------------------------------------------------------------

uploads/
finsight-ai-backend/finsight-ai-backend/uploads/

# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~